<script>
(function(){
  document.documentElement.classList.add('js');
  var els=document.querySelectorAll('.work li, section h2, .about, .contact .btn, .links, footer');
  els.forEach(function(el,i){el.classList.add('reveal');});
  document.querySelectorAll('.work li').forEach(function(el,i){el.style.transitionDelay='0s,0s,'+(i*80)+'ms,'+(i*80)+'ms';});
  if(!('IntersectionObserver' in window)){els.forEach(function(el){el.classList.add('in');});return;}
  var io=new IntersectionObserver(function(entries){
    entries.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target);}});
  },{threshold:0.15});
  els.forEach(function(el){io.observe(el);});
})();
</script>

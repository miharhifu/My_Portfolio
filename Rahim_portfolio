<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Rahim C. Ahil — Portfolio</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@500;800&family=Source+Serif+4:wght@400;600&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#e8eee9; --ink:#10302b; --muted:#4c6660; --line:#b7c7bf; --accent:#d98a00; --accent-ink:#10302b;
  --display:"Bricolage Grotesque","Helvetica Neue",Arial,sans-serif;
  --body:"Source Serif 4",Georgia,"Times New Roman",serif;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){--bg:#0f1f1c;--ink:#e4efe9;--muted:#9bb5ac;--line:#2c4540;--accent:#f0b030;--accent-ink:#0f1f1c;}
}
:root[data-theme="dark"]{--bg:#0f1f1c;--ink:#e4efe9;--muted:#9bb5ac;--line:#2c4540;--accent:#f0b030;--accent-ink:#0f1f1c;}
html{scroll-padding-top:env(safe-area-inset-top,0px);scroll-behavior:smooth}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--body);font-size:1.125rem;line-height:1.65}
a{color:inherit}
a:focus-visible,button:focus-visible{outline:3px solid var(--accent);outline-offset:3px}
.wrap{max-width:62rem;margin:0 auto;padding:0 1.5rem}
nav{display:flex;gap:1.5rem;justify-content:center;padding:1.5rem 0;font-family:var(--display);font-weight:500;font-size:1rem}
nav a{text-decoration:none;border-bottom:2px solid transparent}
nav a:hover{border-color:var(--accent)}
.hero{padding:4rem 0 5rem}
h1{font-family:var(--display);font-weight:800;font-size:clamp(2.75rem,10vw,7rem);line-height:1;letter-spacing:-.04em;margin:0;display:flex;flex-wrap:wrap;justify-content:center;gap:0 .25em}
.lede{max-width:34rem;margin:1rem 0 0;font-size:1.3rem;color:var(--muted)}
section{padding:3.5rem 0;border-top:1px solid var(--line)}
h2{font-family:var(--display);font-weight:800;font-size:clamp(1.8rem,4vw,2.6rem);letter-spacing:-.02em;margin:0 0 2rem;line-height:1.1}
.work{list-style:none;margin:0;padding:0}
.work li{display:grid;grid-template-columns:5rem 1fr;gap:0 1.5rem;padding:1.5rem 0;border-bottom:1px solid var(--line)}
.work li:first-child{padding-top:0}
.year{font-family:var(--display);font-weight:500;color:var(--muted)}
.work h3{font-family:var(--display);font-weight:800;font-size:1.5rem;margin:0 0 .25rem;letter-spacing:-.01em}
.work p{margin:0;max-width:40rem}
.tag{display:inline-block;margin-top:.5rem;font-family:var(--display);font-size:.9rem;color:var(--muted)}
.about{display:grid;gap:2rem;grid-template-columns:1fr}
.about p{margin:0 0 1rem;max-width:38rem}
.skills{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:.5rem}
.skills li{font-family:var(--display);font-weight:500;font-size:.95rem;border:1px solid var(--line);padding:.3rem .8rem;border-radius:99px}
.contact a.btn{display:inline-block;font-family:var(--display);font-weight:800;font-size:1.25rem;background:var(--accent);color:var(--accent-ink);padding:.9rem 1.6rem;border-radius:.4rem;text-decoration:none}
.contact a.btn:hover{filter:brightness(1.08)}
.links{margin:1.5rem 0 0;display:flex;gap:1.5rem;flex-wrap:wrap;font-family:var(--display);font-weight:500}
footer{padding:2rem 0 3rem;color:var(--muted);font-size:.95rem;border-top:1px solid var(--line)}
@media (min-width:48rem){.about{grid-template-columns:2fr 1fr}}
@media (max-width:34rem){.work li{grid-template-columns:1fr}.year{margin-bottom:.25rem}}
/* portrait */
.hero{display:flex;flex-direction:column;align-items:center;text-align:center;position:relative;isolation:isolate}
.hero::before{content:"";position:absolute;inset:-2rem 0 auto;height:75%;background:radial-gradient(ellipse at 50% 30%,color-mix(in srgb,var(--accent) 24%,transparent),transparent 65%);z-index:-1;pointer-events:none}
.portrait{display:block;width:clamp(9rem,26vw,13rem);aspect-ratio:1/1;object-fit:cover;object-position:50% 18%;border-radius:50%;border:6px solid var(--bg);box-shadow:0 0 0 5px var(--accent),0 18px 40px rgba(0,0,0,.18);margin:0 0 2rem;animation:pop .9s cubic-bezier(.2,.8,.2,1) both}
@keyframes pop{from{opacity:0;transform:scale(.8)}to{opacity:1;transform:none}}
.role{font-family:var(--display);font-weight:500;font-size:1.15rem;color:var(--muted);margin:1.5rem 0 0;animation:fade .8s .7s ease-out both}
.cta{display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;margin-top:2rem;animation:fade .8s 1s ease-out both}
.cta a{font-family:var(--display);font-weight:800;text-decoration:none;padding:.8rem 1.5rem;border-radius:99px;border:2px solid var(--ink);transition:transform .2s ease,background-color .2s ease,color .2s ease}
.cta a.primary{background:var(--accent);border-color:var(--accent);color:var(--accent-ink)}
.cta a:hover{transform:translateY(-3px)}
.cta a:not(.primary):hover{background:var(--ink);color:var(--bg)}
.contact{text-align:center}
.contact .links{justify-content:center}
/* motion */
.progress{position:fixed;top:0;left:0;right:0;height:4px;background:var(--accent);transform-origin:0 50%;transform:scaleX(0);z-index:20}
@supports (animation-timeline:scroll()){.progress{animation:grow linear both;animation-timeline:scroll(root)}}
@keyframes grow{to{transform:scaleX(1)}}
@keyframes rise{from{opacity:0;transform:translateY(60%) rotate(2deg)}to{opacity:1;transform:none}}
@keyframes fade{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}
@keyframes bob{0%,100%{transform:translateY(0)}50%{transform:translateY(-.06em)}}
h1 span{animation:rise 1s cubic-bezier(.2,.7,.2,1) both}
h1 span:nth-child(2){animation:rise 1s .15s cubic-bezier(.2,.7,.2,1) both,bob 4s 1.4s ease-in-out infinite}
h1 span:nth-child(3){animation-delay:.3s}
.lede{animation:fade .8s .8s ease-out both}
nav{animation:fade .8s .5s ease-out both}
.js .reveal{opacity:0;transform:translateY(28px);transition:opacity .7s ease,transform .7s cubic-bezier(.2,.7,.2,1)}
.js .reveal.in{opacity:1;transform:none}
.work li{transition:padding-left .3s ease,box-shadow .3s ease,opacity .7s ease,transform .7s cubic-bezier(.2,.7,.2,1)}
.work li:hover{padding-left:1rem;box-shadow:inset 4px 0 0 var(--accent)}
.skills li{transition:transform .2s ease,background-color .2s ease,color .2s ease,border-color .2s ease}
.skills li:hover{transform:translateY(-3px) rotate(-2deg);background:var(--accent);color:var(--accent-ink);border-color:var(--accent)}
.contact a.btn{transition:transform .2s ease,box-shadow .2s ease,filter .2s ease}
.contact a.btn:hover{transform:translateY(-3px);box-shadow:0 8px 0 var(--ink)}
.contact a.btn:active{transform:translateY(2px);box-shadow:none}
.links a{text-decoration:none;background:linear-gradient(var(--accent),var(--accent)) 0 100%/0 3px no-repeat;transition:background-size .3s ease}
.links a:hover{background-size:100% 3px}
@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  *,*::before,*::after{animation:none!important;transition:none!important}
  .js .reveal{opacity:1;transform:none}
  .progress{display:none}
}

/* Neon portfolio theme inspired by the reference screenshot */
:root{--bg:#171125;--ink:#f8f3ff;--muted:#c4b3dc;--line:#33254b;--accent:#a855f7;--accent-ink:#160b24;--display:"Bricolage Grotesque",Arial,sans-serif;--body:"Bricolage Grotesque",Arial,sans-serif;}
body{background:radial-gradient(ellipse at 15% 5%,rgba(133,55,191,.20),transparent 36%),radial-gradient(ellipse at 95% 45%,rgba(57,70,179,.14),transparent 32%),var(--bg);font-size:1rem;}
.wrap{max-width:66rem;padding:0 1.25rem;}
nav{position:sticky;top:0;z-index:10;background:rgba(23,17,37,.88);backdrop-filter:blur(12px);border-bottom:1px solid rgba(184,120,255,.14);}
nav a{padding:.45rem .8rem;border-radius:999px;color:#d9c9ee;}
nav a:hover{background:#30203f;border-color:transparent;}
.hero{padding:3rem 0 3.5rem;}
.hero::before{background:radial-gradient(ellipse at 50% 30%,rgba(168,85,247,.28),transparent 68%);}
.portrait{border-color:#241833;box-shadow:0 0 0 4px #a855f7,0 0 35px rgba(168,85,247,.32);}
h1{font-size:clamp(2.7rem,8vw,5rem);}
.role{color:#d4b5ff;}
.lede{color:#c4b3dc;max-width:37rem;text-align:center;}
.cta a{border-color:#8f54c7;color:#f8f3ff;background:rgba(34,22,49,.8);}
.cta a.primary{background:#a855f7;border-color:#a855f7;color:#160b24;}
section{border-top:1px solid rgba(184,120,255,.16);padding:3rem 0;}
h2{font-size:clamp(2rem,5vw,3rem);margin-bottom:1.5rem;}
#about .about{display:block;}
#about .about>div p{color:#c4b3dc;}
.skills{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;margin-top:1.5rem;}
.skills li{min-height:12rem;border:2px solid #3d2860;border-radius:1.6rem;background:rgba(20,12,32,.88);padding:1.25rem .85rem;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:.65rem;box-shadow:inset 0 0 22px rgba(168,85,247,.035);}
.skills li:nth-child(5n+1){border-color:#164b69;}
.skills li:nth-child(5n+2){border-color:#704023;}
.skills li:nth-child(5n+3){border-color:#17666c;}
.skills li:nth-child(5n+4){border-color:#685b25;}
.skills li:nth-child(5n){border-color:#17665a;}
.skill-icon{width:4.3rem;height:4.3rem;display:grid;place-items:center;border-radius:1.1rem;background:#092d42;border:1px solid #0878a1;color:#50d9ff;font-size:2rem;font-weight:800;box-shadow:0 0 22px rgba(80,217,255,.08);}
.skill-icon svg{width:2.8rem;height:2.8rem;display:block;}
.skills li:nth-child(5n+2) .skill-icon,.skills li:nth-child(5n+4) .skill-icon{background:#3a190e;border-color:#a84a20;color:#ff9c54;}
.skills li:nth-child(5n+3) .skill-icon{background:#073b43;border-color:#11828c;color:#55eff0;}
.skills li:nth-child(5n) .skill-icon{background:#06382b;border-color:#0b8b66;color:#5af2bd;}
.skills li strong{font-size:1.2rem;color:#fff;}
.skills li small{font-size:1rem;line-height:1.5;color:#c4b3dc;}
.skills li:hover{transform:translateY(-5px);background:#211431;color:#fff;box-shadow:0 10px 28px rgba(168,85,247,.12);}
.skills li{transition:transform .22s ease,background .22s ease,box-shadow .22s ease;border-color:rgba(123,91,170,.8);}
.skills li strong{letter-spacing:-.02em;}
.skills li small{max-width:11rem;}
.work li{grid-template-columns:5rem 1fr;padding:1.3rem;border:1px solid #39274f;border-radius:1rem;margin-bottom:1rem;background:rgba(24,15,38,.7);}
.work li:first-child{padding-top:1.3rem;}
.work li:hover{padding-left:1.6rem;box-shadow:inset 4px 0 0 #a855f7;}
.year{color:#d4b5ff;}
.work h3{font-size:1.25rem;}
.work p{color:#c4b3dc;font-size:1rem;}
.contact a.btn{background:#0d302b;color:#70f0c0;border:1px solid #16745f;border-radius:1rem;}
.contact a.btn:hover{box-shadow:0 8px 0 #0b201e;}
.links a{color:#d9c9ee;}
footer{border-color:rgba(184,120,255,.16);}
@media(max-width:34rem){.wrap{padding:0 1rem}.hero{padding:2rem 0 3rem}.skills{gap:.75rem}.skills li{min-height:10.5rem;padding:.9rem .5rem;border-radius:1.2rem}.skill-icon{width:3.6rem;height:3.6rem}.skills li strong{font-size:1.05rem}.skills li small{font-size:.9rem}.work li{grid-template-columns:1fr;gap:.35rem}.year{margin-bottom:.1rem}}

</style>
</head>
<body>
